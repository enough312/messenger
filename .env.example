APP_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
PORT=
PUBLIC_BASE_URL=https://localhost

DB_URL=jdbc:postgresql://postgres:5432/messenger
DB_USER=messenger
DB_PASSWORD=messenger
DB_POOL_SIZE=10
DB_SSL_MODE=

REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ISSUER=messenger
JWT_AUDIENCE=messenger-clients
JWT_REALM=messenger
JWT_SECRET=change-me-access-secret
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30

MINIO_ENDPOINT=http://minio:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=messenger-media
S3_PATH_STYLE=true
S3_AUTO_CREATE_BUCKET=true

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=./secrets/firebase.json

TOTP_ISSUER=Messenger

TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
STUN_URL=stun:stun.l.google.com:19302
